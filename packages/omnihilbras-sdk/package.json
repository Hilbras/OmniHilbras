{
  "name": "@hilbras/omnihilbras",
  "version": "0.4.1",
  "description": "Typed provider SDK for the OmniHilbras gateway: normalized chat, streaming, model listing, and capability contracts for OpenAI, Anthropic, Gemini, and OpenAI-compatible providers.",
  "license": "MIT",
  "author": "Hilbras",
  "homepage": "https://github.com/Hilbras/OmniHilbras#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hilbras/OmniHilbras.git",
    "directory": "packages/omnihilbras-sdk"
  },
  "bugs": {
    "url": "https://github.com/Hilbras/OmniHilbras/issues"
  },
  "keywords": [
    "omnihilbras",
    "ai-gateway",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "provider-abstraction",
    "streaming"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.js",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.0"
  }
}
