{
  "name": "@omnihilbras/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @omnihilbras/hilbras build && tsc -p tsconfig.json",
    "dev": "pnpm build && node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @omnihilbras/hilbras build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @omnihilbras/hilbras build && pnpm build && node --test test/*.test.js"
  },
  "dependencies": {
    "@omnihilbras/hilbras": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.0"
  }
}
