{
  "name": "omnihilbras-site",
  "private": true,
  "version": "3.22.0",
  "description": "Provider-neutral local gateway and desktop dashboard",
  "author": {
    "name": "Hilbras",
    "email": "opencode@example.com"
  },
  "desktopName": "omnihilbras.desktop",
  "homepage": "https://github.com/Hilbras/OmniHilbras",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:gateway": "pnpm --filter @omnihilbras/kernel-api dev",
    "app:dev": "pnpm build:gateway && pnpm build:frontend && node scripts/run-electron.mjs",
    "app:start": "node scripts/run-electron.mjs",
    "app:smoke": "node scripts/app-smoke.mjs",
    "app:check": "pnpm build:gateway && pnpm build:frontend && node scripts/app-smoke.mjs",
    "app:size": "node scripts/app-size.mjs",
    "app:build": "pnpm build && electron-builder --dir",
    "app:exe": "pnpm build && electron-builder --win nsis --config.nsis.packElevateHelper=false --config.win.signExecutable=false",
    "app:pack": "pnpm build && electron-builder",
    "build": "pnpm build:sdk && pnpm build:token-saver && pnpm build:gateway && pnpm build:frontend",
    "build:frontend": "vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "build:sdk": "node scripts/clean-sdk-dist.mjs && pnpm -r --workspace-concurrency=2 --filter \"./Kernel/SDK/*\" build",
    "build:token-saver": "pnpm --filter @omnihilbras/token-saver build",
    "build:gateway": "node scripts/clean-sdk-dist.mjs --gateway && pnpm --filter @omnihilbras/kernel-api build",
    "preview": "vite preview",
    "typecheck": "pnpm build:sdk && pnpm build:token-saver && pnpm build:gateway && tsc --noEmit && pnpm typecheck:gateway",
    "typecheck:gateway": "pnpm --filter @omnihilbras/kernel-api typecheck",
    "test": "pnpm build:sdk && pnpm build:token-saver && pnpm build:gateway && pnpm test:repo && pnpm test:sdk && pnpm test:gateway && pnpm test:token-saver",
    "test:repo": "node --test tests/*.test.js",
    "test:token-saver": "node --test Kernel/TokenSaver/test/*.test.js",
    "test:sdk": "node --test Kernel/SDK/tests/*.test.js",
    "test:gateway": "pnpm --filter @omnihilbras/kernel-api test",
    "version:check": "node scripts/check-version.mjs",
    "version:fix": "node scripts/check-version.mjs --fix",
    "analyze": "node scripts/analyze-bundle.mjs",
    "analyze:check": "node scripts/analyze-bundle.mjs --check",
    "verify": "pnpm version:check && pnpm test:brand && pnpm typecheck && pnpm test && node Kernel/API/test/spec-success-criteria.mjs && pnpm build && pnpm analyze:check",
    "test:brand": "BRAND_STRICT=1 node --test tests/brand-assets.test.js",
    "brand": "node scripts/generate-brand.mjs",
    "release:audit": "node scripts/audit-release-trail.mjs",
    "build:android": "vite build --config vite.android.config.ts && node scripts/finalize-android.mjs",
    "android:add": "pnpm build:android && cap add android",
    "android:sync": "pnpm build:android && cap sync android",
    "android:apk": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@omnihilbras/kernel-api": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "omnihilbras": "./bin/omnihilbras.js"
  },
  "build": {
    "appId": "ai.hilbras.omnihilbras",
    "productName": "OmniHilbras",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "brand/**",
      "dist/**",
      "Kernel/API/dist/**",
      "Kernel/SDK/*/dist/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "Kernel/**",
      "node_modules/**"
    ],
    "linux": {
      "target": [
        "dir",
        "deb",
        "AppImage"
      ],
      "icon": "brand/logo-512.png",
      "category": "Development",
      "executableName": "omnihilbras",
      "artifactName": "OmniHilbras-linux-amd64.${ext}",
      "maintainer": "Hilbras <opencode@example.com>",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "brand/logo-512.png",
      "executableName": "omnihilbras",
      "artifactName": "OmniHilbras-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "brand/logo-512.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "OmniHilbras-macos.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hilbras",
        "repo": "OmniHilbras"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OmniHilbras"
    }
  }
}
