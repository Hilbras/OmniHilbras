{
  "name": "omnihilbras-site",
  "private": true,
  "version": "1.17.0",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gateway": "pnpm --filter @omnihilbras/gateway dev",
    "build": "pnpm build:frontend && pnpm build:sdk && pnpm build:gateway",
    "build:frontend": "vite build",
    "build:sdk": "pnpm --filter @hilbras/omnihilbras build",
    "build:gateway": "pnpm --filter @omnihilbras/gateway build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm typecheck:sdk && pnpm typecheck:gateway",
    "typecheck:sdk": "pnpm --filter @hilbras/omnihilbras typecheck",
    "typecheck:gateway": "pnpm --filter @omnihilbras/gateway typecheck",
    "test": "pnpm test:sdk && pnpm test:gateway",
    "test:sdk": "pnpm --filter @hilbras/omnihilbras test",
    "test:gateway": "pnpm --filter @omnihilbras/gateway test",
    "version:check": "node scripts/check-version.mjs",
    "version:fix": "node scripts/check-version.mjs --fix",
    "verify": "pnpm version:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hilbras/omnihilbras": "workspace:*",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
