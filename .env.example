# Optional environment credentials. Dashboard-saved OpenRouter credentials
# are stored by the local gateway, not in the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OMNIHILBRAS_COMPATIBLE_API_KEY=

# Optional local gateway settings.
OMNIHILBRAS_HOST=127.0.0.1
OMNIHILBRAS_PORT=8787
OMNIHILBRAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OMNIHILBRAS_DATA_DIR=
OMNIHILBRAS_MASTER_KEY=

# Optional Codex OAuth overrides. Leave both empty to use the public Codex CLI OAuth
# client, which is what makes sign-in work with no setup at all.
#
# Setting them uses your own OAuth client instead, so both must be set together and
# the URI must be the one registered for that client. A provider only redirects to a
# URI registered for the client that asked, so a half-configured pair is refused at
# startup rather than failing silently at the click.
OMNIHILBRAS_CODEX_CLIENT_ID=
OMNIHILBRAS_CODEX_REDIRECT_URI=

# The Codex CLI version sent when asking the provider which models this account can
# serve. The provider hides entries whose minimum version is newer than this, and does
# it silently — a 200 with models missing rather than an error — so a value that is too
# low looks exactly like an account with few models. Raise it if a model you know exists
# is missing, and restart.
OMNIHILBRAS_CODEX_CLIENT_VERSION=
